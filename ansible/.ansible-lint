---
profile: basic
exclude_paths:
  - .git/
  - roles/*/files/
warn_list:
  - yaml[line-length]
skip_list:
  - yaml[truthy]
  # Role-prefix naming conflicts with cross-role shared vars (deploy_user, etc.)
  - var-naming[no-role-prefix]
  # fqcn for import_tasks not required until Ansible 2.15+
  - fqcn[action-core]
