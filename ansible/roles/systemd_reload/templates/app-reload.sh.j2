#!/usr/bin/env bash
set -euo pipefail

working_directory="{{ app_reload_working_directory }}"
compose_file="{{ app_reload_compose_file }}"
compose_service="{{ app_reload_compose_service }}"

cd "$working_directory"

# Validate the compose file before trying to roll the app service.
 /usr/bin/docker compose -f "$compose_file" config -q

# Future hook: a migration command could be added here before the app
# container is rebuilt.
exec /usr/bin/docker compose -f "$compose_file" up -d --build --no-deps "$compose_service"