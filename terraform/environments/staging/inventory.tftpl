---
# generated by terraform — do not edit manually
all:
  children:
    webservers:
      hosts:
%{ for i, ip in app_servers ~}
        ${app_names[i]}:
          ansible_host: ${ip}
          ansible_user: deploy
          env: ${env}
%{ endfor ~}
    dbservers:
      hosts:
        ${db_name}:
          ansible_host: ${db_private_ip}
          ansible_user: deploy
          env: ${env}
